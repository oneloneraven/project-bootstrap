{
  "name": "cloudflare-opentofu",
  "dependsOn": [
    "web-app",
    "cloudflare-tofu-base"
  ],
  "maxSlugLength": 40,
  "questions": [
    {
      "key": "zone_name",
      "type": "hostname",
      "prompt": "Which domain (Cloudflare zone) will the app be served from?"
    },
    {
      "key": "beta",
      "type": "boolean",
      "prompt": "Do you want a beta environment, with releases deployed to beta first and promoted to production by hand?"
    },
    {
      "key": "admin",
      "type": "boolean",
      "prompt": "Does the app have an admin section for its owner, signed in through the central identity stack and checked again in the Worker?"
    },
    {
      "key": "admin_subdomain",
      "type": "dns_label",
      "when": "admin",
      "prompt": "Which subdomain serves the admin section (default admin)?"
    },
    {
      "key": "turnstile",
      "type": "boolean",
      "prompt": "Does the app have a public form guarded by Turnstile, with its widget in the central identity stack?"
    },
    {
      "key": "d1",
      "type": "boolean",
      "prompt": "Does the app keep data in a D1 database?"
    }
  ],
  "fragments": {
    "admin_production_vars": {
      "path": "templates/fragments/admin-production-vars.json",
      "when": "admin"
    },
    "admin_production_route": {
      "path": "templates/fragments/admin-production-route.json",
      "when": "admin"
    },
    "admin_e2e_vars": {
      "path": "templates/fragments/admin-e2e-vars.json",
      "when": "admin"
    },
    "admin_dev_vars_example": {
      "path": "templates/fragments/admin-dev-vars-example.txt",
      "when": "admin"
    },
    "admin_readme": {
      "path": "templates/fragments/admin-readme.md",
      "when": "admin"
    },
    "turnstile_production_vars": {
      "path": "templates/fragments/turnstile-production-vars.json",
      "when": "turnstile"
    },
    "turnstile_test_vars": {
      "path": "templates/fragments/turnstile-test-vars.json",
      "when": "turnstile"
    },
    "turnstile_previews_vars": {
      "path": "templates/fragments/turnstile-previews-vars.json",
      "when": "turnstile"
    },
    "turnstile_dev_vars_example": {
      "path": "templates/fragments/turnstile-dev-vars-example.txt",
      "when": "turnstile"
    },
    "turnstile_readme": {
      "path": "templates/fragments/turnstile-readme.md",
      "when": "turnstile"
    },
    "sync_owner_email": {
      "path": "templates/fragments/sync-owner-email.yml",
      "when": "admin"
    },
    "sync_turnstile": {
      "path": "templates/fragments/sync-turnstile.yml",
      "when": "turnstile"
    },
    "sync_secrets_readme": {
      "path": "templates/fragments/sync-secrets-readme.md",
      "when": [
        "admin",
        "turnstile"
      ]
    },
    "turnstile_sync_beta": {
      "path": "templates/fragments/turnstile-sync-beta.txt",
      "when": "beta"
    },
    "d1_wrangler_top": {
      "path": "templates/fragments/d1-wrangler-top.json",
      "when": "d1"
    },
    "d1_wrangler_env": {
      "path": "templates/fragments/d1-wrangler-env.json",
      "when": "d1"
    },
    "d1_wrangler_preview": {
      "path": "templates/fragments/d1-wrangler-preview.json",
      "when": "d1"
    },
    "d1_wrangler_previews": {
      "path": "templates/fragments/d1-wrangler-previews.json",
      "when": "d1"
    },
    "d1_local_migrate_dev": {
      "path": "templates/fragments/d1-local-migrate-dev.txt",
      "when": "d1"
    },
    "d1_local_migrate": {
      "path": "templates/fragments/d1-local-migrate.txt",
      "when": "d1"
    },
    "d1_token_write": {
      "path": "templates/fragments/d1-token-write.json",
      "when": "d1"
    },
    "d1_token_read": {
      "path": "templates/fragments/d1-token-read.json",
      "when": "d1"
    },
    "d1_readme_write": {
      "path": "templates/fragments/d1-readme-write.txt",
      "when": "d1"
    },
    "d1_readme_read": {
      "path": "templates/fragments/d1-readme-read.txt",
      "when": "d1"
    },
    "d1_readme": {
      "path": "templates/fragments/d1-readme.md",
      "when": "d1"
    },
    "d1_deploy_production": {
      "path": "templates/fragments/d1-deploy-production.yml",
      "when": "d1"
    },
    "d1_deploy_beta": {
      "path": "templates/fragments/d1-deploy-beta.yml",
      "when": "d1"
    },
    "d1_preview_database": {
      "path": "templates/fragments/d1-preview-database.yml",
      "when": "d1"
    },
    "d1_preview_config_flag": {
      "path": "templates/fragments/d1-preview-config-flag.txt",
      "when": "d1"
    },
    "d1_preview_cleanup": {
      "path": "templates/fragments/d1-preview-cleanup.yml",
      "when": "d1"
    }
  },
  "overrides": [],
  "files": [
    {
      "from": "templates/package.json",
      "to": "package.json",
      "merge": true
    },
    {
      "from": "templates/wrangler-beta.jsonc",
      "to": "wrangler.jsonc",
      "when": "beta"
    },
    {
      "from": "templates/wrangler.jsonc",
      "to": "wrangler.jsonc",
      "when": "!beta"
    },
    {
      "from": "templates/dev.vars.example",
      "to": ".dev.vars.example"
    },
    {
      "from": "templates/infra/main.tf",
      "to": "infra/main.tf"
    },
    {
      "from": "templates/infra/variables.tf",
      "to": "infra/variables.tf"
    },
    {
      "from": "templates/infra/outputs.tf",
      "to": "infra/outputs.tf"
    },
    {
      "from": "templates/infra/dns.tf",
      "to": "infra/dns.tf"
    },
    {
      "from": "templates/infra/dns-beta.tf",
      "to": "infra/dns-beta.tf",
      "when": "beta"
    },
    {
      "from": "templates/infra/dns-admin.tf",
      "to": "infra/dns-admin.tf",
      "when": "admin"
    },
    {
      "from": "templates/infra/d1.tf",
      "to": "infra/d1.tf",
      "when": "d1"
    },
    {
      "from": "templates/migrations/.gitkeep",
      "to": "migrations/.gitkeep",
      "when": "d1"
    },
    {
      "from": "templates/infra/redirects.tf",
      "to": "infra/redirects.tf"
    },
    {
      "from": "templates/infra/security.tf",
      "to": "infra/security.tf"
    },
    {
      "from": "templates/infra/cache.tf",
      "to": "infra/cache.tf"
    },
    {
      "from": "templates/infra/terraform.tfvars.example",
      "to": "infra/terraform.tfvars.example"
    },
    {
      "from": "templates/bootstrap/cloudflare-tokens.json",
      "to": ".bootstrap/cloudflare/tokens.json",
      "when": "!beta"
    },
    {
      "from": "templates/bootstrap/cloudflare-tokens-beta.json",
      "to": ".bootstrap/cloudflare/tokens.json",
      "when": "beta"
    },
    {
      "from": "templates/infra/README.md",
      "to": "infra/README.md",
      "vault": true
    },
    {
      "from": "templates/github/workflows/infra.yml",
      "to": ".github/workflows/infra.yml"
    },
    {
      "from": "templates/github/workflows/preview.yml",
      "to": ".github/workflows/preview.yml"
    },
    {
      "from": "templates/github/workflows/deploy-beta.yml",
      "to": ".github/workflows/deploy.yml",
      "when": "beta"
    },
    {
      "from": "templates/github/workflows/deploy.yml",
      "to": ".github/workflows/deploy.yml",
      "when": "!beta"
    },
    {
      "from": "templates/github/workflows/promote.yml",
      "to": ".github/workflows/promote.yml",
      "when": "beta"
    },
    {
      "from": "templates/github/workflows/sync-worker-secrets.yml",
      "to": ".github/workflows/sync-worker-secrets.yml",
      "when": [
        "admin",
        "turnstile"
      ]
    },
    {
      "from": "templates/src/worker.js",
      "to": "src/worker.js",
      "stage": "app",
      "when": "!admin"
    },
    {
      "from": "templates/src/worker-admin.js",
      "to": "src/worker.js",
      "when": "admin",
      "stage": "app"
    },
    {
      "from": "templates/src/lib/access.js",
      "to": "src/lib/access.js",
      "when": "admin",
      "stage": "app"
    },
    {
      "from": "templates/test/worker.test.js",
      "to": "test/worker.test.js",
      "stage": "app",
      "when": "!admin"
    },
    {
      "from": "templates/test/worker-admin.test.js",
      "to": "test/worker.test.js",
      "when": "admin",
      "stage": "app"
    },
    {
      "from": "templates/test/lib/access.test.js",
      "to": "test/lib/access.test.js",
      "when": "admin",
      "stage": "app"
    },
    {
      "from": "templates/src/lib/turnstile.js",
      "to": "src/lib/turnstile.js",
      "when": "turnstile",
      "stage": "app"
    },
    {
      "from": "templates/test/lib/turnstile.test.js",
      "to": "test/lib/turnstile.test.js",
      "when": "turnstile",
      "stage": "app"
    }
  ],
  "requiredChecks": [],
  "releasePaths": {
    "noneAllowed": [],
    "noneForbidden": [
      "infra/",
      "migrations/",
      "wrangler.jsonc"
    ]
  },
  "claudeIndexLines": [
    "- Cloudflare Workers, deployed by wrangler from release tags; infrastructure in OpenTofu: [coding standards](docs/coding-standards.md#cloudflare-and-opentofu), infra (in the vault). Merging `infra/` is a production change.",
    "- Never change anything `infra/` manages, or add to a zone it manages, through an API, an MCP tool or the dashboard. Change it in `infra/` through a PR: \"Changing infrastructure\" in the infra README (in the vault)."
  ],
  "screening": [
    {
      "dependency": "Cloudflare (hosting, DNS, R2)",
      "usedFor": "Hosting the Worker, DNS and the infrastructure state bucket",
      "maintainer": "Cloudflare, Inc.",
      "listed": "N",
      "decision": "Allowed",
      "screenedOn": "2026-10-28"
    },
    {
      "dependency": "wrangler",
      "usedFor": "Deploying and previewing the Worker",
      "maintainer": "Cloudflare, Inc.",
      "listed": "N",
      "decision": "Allowed",
      "screenedOn": "2026-10-28"
    }
  ],
  "allowBuilds": {
    "workerd": {
      "allow": true,
      "reason": "wrangler's local runtime downloads its platform binary at install."
    }
  },
  "environments": [
    {
      "name": "production",
      "refs": [
        {
          "ref": "branch:main",
          "when": [
            "beta",
            "admin",
            "turnstile"
          ]
        },
        "tag:v*"
      ],
      "step": "github:cloudflare-opentofu:1"
    },
    {
      "name": "beta",
      "refs": [
        "tag:v*"
      ],
      "when": "beta",
      "step": "github:cloudflare-opentofu:1"
    }
  ],
  "secrets": [
    {
      "name": "CLOUDFLARE_PREVIEW_TOKEN"
    },
    {
      "name": "CLOUDFLARE_DEPLOY_TOKEN",
      "scope": "environment",
      "environment": "production",
      "step": "github:cloudflare-opentofu:1"
    },
    {
      "name": "CLOUDFLARE_DEPLOY_TOKEN",
      "scope": "environment",
      "environment": "beta",
      "when": "beta",
      "step": "github:cloudflare-opentofu:1"
    },
    {
      "name": "OWNER_EMAIL",
      "scope": "environment",
      "environment": "production",
      "when": "admin",
      "step": "github:cloudflare-opentofu:1"
    },
    {
      "name": "TURNSTILE_SECRET_KEY",
      "scope": "environment",
      "environment": "production",
      "when": "turnstile",
      "step": "github:cloudflare-opentofu:1"
    }
  ]
}
