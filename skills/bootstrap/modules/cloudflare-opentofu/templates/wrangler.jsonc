// Bindings are repeated in every environment: an environment that omits one does not inherit it.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "{{slug}}",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"{{fragment_admin_run_worker_first_top}}
  },
  "vars": {
    "APP_ENV": "development"
  }{{fragment_d1_wrangler_top}},
  "env": {
    "production": {
      "vars": {
        "APP_ENV": "production"{{fragment_admin_production_vars}}{{fragment_turnstile_production_vars}}
      },
      "assets": {
        "directory": "./dist",
        "binding": "ASSETS"{{fragment_admin_run_worker_first}}
      }{{fragment_d1_wrangler_env}},
      "routes": [
        {
          "pattern": "{{app_host}}/*",
          "zone_name": "{{zone_name}}"
        }{{fragment_admin_production_route}}
      ]
    },
    "preview": {
      "vars": {
        "APP_ENV": "preview"{{fragment_turnstile_test_vars}}
      },
      "assets": {
        "directory": "./dist",
        "binding": "ASSETS"{{fragment_admin_run_worker_first}}
      }{{fragment_d1_wrangler_preview}},
      "workers_dev": true,
      "preview_urls": true,
      "previews": {
        "vars": {
          "APP_ENV": "preview"{{fragment_turnstile_previews_vars}}
        }{{fragment_d1_wrangler_previews}}
      }
    },
    "e2e": {
      "vars": {
        "APP_ENV": "e2e"{{fragment_admin_e2e_vars}}{{fragment_turnstile_test_vars}}
      },
      "assets": {
        "directory": "./dist",
        "binding": "ASSETS"{{fragment_admin_run_worker_first}}
      }{{fragment_d1_wrangler_env}}
    }
  }
}
